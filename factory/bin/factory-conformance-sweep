#!/usr/bin/env python3
"""Run the conformance battery across every registered target. Exit non-zero on any failure.

    factory/bin/factory-conformance-sweep
    factory/bin/factory-conformance-sweep --target clickhouse-meshbench --serve-gate

This is the "maintains" half of the factory. A factory that only builds is half
a factory: integrations rot because sources change underneath them, and the
failure is usually SILENT — a column that became nullable, a timestamp that
changed zone, an enum that gained a value. The sweep exists so that the first
thing to notice is a timer, not a customer.

On failure it writes `REPAIR-BRIEF-<dialect>-<YYYYMMDD>.md` from the template
in the `r64-factory-maintenance` skill, including a diff of the failing
evidence pack against the last green one for that dialect.

# Why a `last-green` copy exists

Evidence packs are named by date, so a failing run on the same day would
overwrite the very pack a repair brief needs to diff against. Each green sweep
therefore snapshots its pack to `factory/evidence/last-green/EVIDENCE-<dialect>.json`,
which is what makes "what changed since it worked" answerable at the moment it
stops working rather than only in hindsight.

# Environmental prerequisites are FAILURES, not skips

A stopped container or an unreachable source turns the sweep red. Silently
skipping a target whose source is down would turn the timer into decoration:
the one week the sweep quietly checks nothing is the week you needed it.

# Why the sweep commits its own packs (`--auto-commit`)

Doctrine is artifact-before-handoff: *nothing exists until it is a committed
file*, and evidence packs are committed artifacts rather than build output. A
weekly timer that regenerates packs and leaves them dirty in the working tree
inverts that — the record of the last four green sweeps is indistinguishable
from an uncommitted local experiment, and `git log` cannot answer "when did
this last pass".

So a green sweep commits its own evidence subtree, and a red one NEVER does.
That asymmetry is the whole point: a failing pack belongs beside a repair brief
that a human reads, not auto-filed into history where it reads as a record of
work rather than an alarm.

Three fences make the commit safe to run unattended:

1. **Pathspec-limited.** `git add`/`git commit` are both scoped to the evidence
   directory. An unattended `git commit -a` on a timer would sweep up whatever
   a human happened to be editing at 04:00 on a Sunday.
2. **In-repo only.** An `--evidence-dir` outside the checkout is refused, not
   silently skipped — it means the caller asked for something that cannot be
   done, and the test suite's `tmp_path` runs simply never pass the flag.
3. **Size-fenced.** `_COMMIT_MAX_BYTES` refuses an unexpectedly large payload.
   The packs are ~30 KB and the one stored artifact is 36 KB, but a future
   target storing a meshbench-sized artifact (~150 MB) would otherwise bloat
   the repo permanently, on a timer, with nobody watching.

One inherent wrinkle, stated rather than hidden: a pack records the commit that
was HEAD when the battery ran, and committing the pack moves HEAD past it. A
committed pack therefore names its own parent. A file cannot contain its own
hash; the pairing is still exact, one commit apart.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[2]


def _reexec_under_venv() -> None:
    """Re-exec under the repo venv if the engine is not importable.

    Standing discipline is that the suite and its tooling run under
    `.venv/bin/python` and never a bare interpreter. Rather than fail with an
    ImportError when someone runs `./factory/bin/factory-conformance-sweep`
    directly, this hands off to the right interpreter once. `PYTHONNOUSERSITE`
    is set for the child for the same reason it is set everywhere else here:
    a stray package in ~/.local must not shadow the pinned one.
    """
    if importlib.util.find_spec("r64_db_engine") is not None:
        return
    venv_python = REPO_ROOT / ".venv" / "bin" / "python"
    if not venv_python.exists() or os.environ.get("_R64_SWEEP_REEXEC"):
        return
    os.environ["_R64_SWEEP_REEXEC"] = "1"
    os.environ["PYTHONNOUSERSITE"] = "1"
    os.execv(str(venv_python), [str(venv_python), str(Path(__file__).resolve()), *sys.argv[1:]])


_reexec_under_venv()
sys.path.insert(0, str(REPO_ROOT))

from factory import conformance  # noqa: E402
from factory.repair import write_repair_brief  # noqa: E402


def discover_targets(targets_dir: Path, only: str | None) -> list[Path]:
    targets = sorted(p for p in targets_dir.glob("*.yaml"))
    if only:
        targets = [p for p in targets if p.stem == only]
        if not targets:
            raise SystemExit(
                f"--target {only!r} matched nothing in {targets_dir} "
                f"(available: {[p.stem for p in sorted(targets_dir.glob('*.yaml'))]})"
            )
    if not targets:
        raise SystemExit(
            f"no targets found in {targets_dir}. A sweep with nothing to sweep exits "
            f"non-zero rather than reporting success over an empty set."
        )
    return targets


def resolve_ground_truth(target: Path, dialect: str, ground_truth_dir: Path) -> Path:
    """Find the ground truth for a target, by dataset name then by dialect name.

    Two conventions exist in the repo and both are honoured rather than one
    being renamed: `GROUND-TRUTH-clickhouse.json` is named for its dialect (it
    predates the factory), `GROUND-TRUTH-openmeteo.json` for its dataset.
    Renaming a committed evidence-bearing file to satisfy a naming rule would
    be a contract-touching change made for tidiness.
    """
    stem = target.stem
    dataset = stem[len(dialect) + 1:] if stem.startswith(f"{dialect}-") else stem
    for candidate in (
        ground_truth_dir / f"GROUND-TRUTH-{dataset}.json",
        ground_truth_dir / f"GROUND-TRUTH-{dialect}.json",
    ):
        if candidate.exists():
            return candidate
    raise SystemExit(
        f"no ground truth for target {stem!r}: tried GROUND-TRUTH-{dataset}.json and "
        f"GROUND-TRUTH-{dialect}.json in {ground_truth_dir}. The battery gates aggregates "
        f"against source-captured expectations, so a target without them cannot be swept."
    )


def run_target(target: Path, args: argparse.Namespace) -> list[dict[str, Any]]:
    """Run the battery for every table in one target. Returns per-table results."""
    doc = conformance.load_yaml(target)
    dialect = doc.get("dialect")
    if not dialect:
        raise SystemExit(f"{target}: no `dialect` key")

    ground_truth = resolve_ground_truth(target, dialect, Path(args.ground_truth_dir))
    evidence_dir = Path(args.evidence_dir)
    results: list[dict[str, Any]] = []

    for entry in doc.get("tables", []):
        table = entry.get("target")
        argv = [
            "--dialect", dialect,
            "--config", str(target),
            "--ground-truth", str(ground_truth),
            "--table", table,
            "--evidence-dir", str(evidence_dir),
        ]
        if args.work_dir:
            argv += ["--work-dir", str(Path(args.work_dir) / target.stem)]
        if args.serve_gate:
            argv += ["--serve-gate"]
        if args.repair_store:
            argv += ["--repair-store"]
        if args.date:
            argv += ["--date", args.date]

        print(f"\n=== sweep: {target.stem} / {table} ({dialect}) ===", flush=True)
        stamp = args.date or datetime.now().strftime("%Y%m%d")
        pack_path = evidence_dir / f"EVIDENCE-{dialect}-{stamp}.json"

        # Each target/table runs as an ISOLATED, TIME-BOUNDED SUBPROCESS rather
        # than in-process, for three reasons that were each learned the hard way:
        #
        # 1. TIME BOUND. A source that is unreachable rather than wrong does not
        #    fail fast — the clickhouse client retried against a dead port for
        #    ELEVEN MINUTES and was still going. In-process there was nothing to
        #    stop it, so the sweep hung. A hung sweep is strictly worse than a
        #    failed one: nothing alerts, and the timer looks like it is working.
        # 2. ISOLATION. One target's exception, `SystemExit`, or leaked state
        #    cannot take the rest of the sweep down with it. An in-process
        #    version crashed the whole run on a `SystemExit` carrying a STRING
        #    message (`int(exc.code)` -> ValueError), so one misconfigured target
        #    silently cancelled every later target — the opposite of a sweep.
        # 3. The child is the same entry point an operator would run by hand, so
        #    the sweep cannot drift away from the documented CLI.
        #
        # stdout/stderr are INHERITED rather than captured, so a 4-minute run is
        # watchable live and journalctl gets everything for the systemd case.
        try:
            completed = subprocess.run(
                [sys.executable, "-m", "factory.conformance", *argv],
                cwd=REPO_ROOT,
                timeout=args.per_target_timeout,
                check=False,
            )
            code = completed.returncode
        except subprocess.TimeoutExpired:
            print(
                f"[sweep] {target.stem}/{table} TIMED OUT after "
                f"{args.per_target_timeout}s and was killed",
                file=sys.stderr,
            )
            results.append({
                "target": target.stem, "table": table, "dialect": dialect,
                "verdict": "ERROR", "code": 1,
                "pack": str(pack_path) if pack_path.exists() else None,
                "error": (
                    f"the battery did not complete within {args.per_target_timeout}s and was "
                    f"killed. An unreachable source is the usual cause — a client retrying "
                    f"against a dead endpoint does not fail fast. This is a RED sweep, never "
                    f"a skip."
                ),
            })
            continue

        # A battery that FAILED always wrote a pack; a battery that REFUSED its
        # own inputs (missing spec, unknown table) never got that far. The pack's
        # presence is what separates "the source drifted" from "this target is
        # misconfigured", and they need different briefs.
        if code == 0:
            verdict = "PASS"
            error = None
        elif pack_path.exists():
            verdict = "FAIL"
            error = None
        else:
            verdict = "ERROR"
            error = (
                f"the battery exited {code} without writing an evidence pack, so it refused "
                f"its own inputs rather than failing a check. See the run log above "
                f"(journalctl -u r64-factory-conformance.service -e under systemd)."
            )

        results.append({
            "target": target.stem, "table": table, "dialect": dialect,
            "verdict": verdict, "code": code,
            "pack": str(pack_path) if pack_path.exists() else None,
            "ground_truth": str(ground_truth),
            "error": error,
        })
    return results


def snapshot_green(pack_path: Path, dialect: str, evidence_dir: Path) -> Path:
    """Record this pack as the last known-good one for the dialect."""
    directory = evidence_dir / "last-green"
    directory.mkdir(parents=True, exist_ok=True)
    destination = directory / f"EVIDENCE-{dialect}.json"
    shutil.copy2(pack_path, destination)
    return destination


def last_green(dialect: str, evidence_dir: Path) -> dict[str, Any] | None:
    path = evidence_dir / "last-green" / f"EVIDENCE-{dialect}.json"
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return None


# The evidence subtree is small by design: two packs per dialect (~30 KB each)
# plus whatever `--repair-store` pins. 8 MiB is roughly two orders of magnitude
# of headroom over today's 148 KB and still two orders BELOW a meshbench
# artifact, so it catches the failure mode (a large artifact landing in the
# committed tree) without tripping on ordinary growth.
_COMMIT_MAX_BYTES = 8 * 1024 * 1024


class AutoCommitRefused(RuntimeError):
    """The commit was asked for and could not be done. Never downgraded to a skip."""


def _git(*argv: str, repo_root: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *argv], cwd=repo_root, capture_output=True, text=True, check=False
    )


def should_auto_commit(
    results: list[dict[str, Any]], drift_events: list[dict[str, Any]]
) -> tuple[bool, str]:
    """Decide whether this sweep's evidence may be auto-committed, and say why.

    Split out as a pure function because the rule it encodes — failures never
    auto-commit — is the one thing here that must be testable without a git
    repository, a live source, or a timer.

    A refusal always carries its reason: "I did not commit" and "there was
    nothing to commit" are different answers, and only the second is a no-op.
    """
    if drift_events:
        return False, (
            f"{len(drift_events)} unresolved recipe drift event(s) — the batteries may be "
            f"green but a provider has already changed, so this is not a green sweep"
        )
    failed = [r for r in results if r["verdict"] != "PASS"]
    if failed:
        listing = ", ".join(f"{r['target']}/{r['table']}={r['verdict']}" for r in failed)
        return False, (
            f"{len(failed)} of {len(results)} run(s) not PASS ({listing}) — a failing pack "
            f"belongs beside its repair brief for a human to read, never auto-filed into history"
        )
    if not results:
        return False, "the sweep produced no results at all"
    return True, f"{len(results)}/{len(results)} PASS"


def commit_message(stamp: str, results: list[dict[str, Any]], scope: str | None) -> str:
    """Build the commit message. Subject is the fixed pattern; body carries the findings.

    `git log` is where a future reader learns what the factory was doing, so the
    body names every target/table that was green and the ground truth it was
    gated against, rather than leaving the subject line to stand alone.
    """
    total = len(results)
    subject = f"evidence: sweep {stamp}, {total}/{total} PASS"
    lines = [subject, ""]
    if scope:
        lines.append(f"Scoped to a single target (--target {scope}).")
        lines.append("")
    lines.append("Green target/table runs, auto-committed by the conformance sweep:")
    for result in results:
        lines.append(
            f"  - {result['target']}/{result['table']} ({result['dialect']}): {result['verdict']}"
        )
    lines.append("")
    lines.append(
        "Packs record the commit that was HEAD when the battery ran, so they name "
        "this commit's parent. A file cannot contain its own hash."
    )
    return "\n".join(lines)


def auto_commit_green(
    evidence_dir: Path, message: str, repo_root: Path = REPO_ROOT
) -> str | None:
    """Commit the evidence subtree. Returns the new commit sha, or None if unchanged.

    Raises `AutoCommitRefused` for anything the caller asked for and could not
    get. The caller turns that into a red sweep: a pack that failed to become a
    committed artifact is exactly the artifact-before-handoff failure the flag
    exists to prevent, and swallowing it would leave the timer looking healthy
    while the record it maintains quietly stopped being maintained.
    """
    evidence_dir = evidence_dir.resolve()
    repo_root = repo_root.resolve()

    # Fence 2: in-repo only. `relative_to` is the check — an evidence dir under
    # a pytest `tmp_path` lands here only if someone passed --auto-commit with
    # it, which is a misconfiguration worth naming rather than ignoring.
    try:
        pathspec = evidence_dir.relative_to(repo_root)
    except ValueError:
        raise AutoCommitRefused(
            f"--auto-commit needs an --evidence-dir inside the checkout, but "
            f"{evidence_dir} is outside {repo_root}. Either drop --auto-commit or point "
            f"--evidence-dir at the repo's own evidence directory."
        ) from None

    inside = _git("rev-parse", "--is-inside-work-tree", repo_root=repo_root)
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        raise AutoCommitRefused(
            f"--auto-commit was requested but {repo_root} is not a git work tree "
            f"(git said: {inside.stderr.strip() or inside.stdout.strip() or 'nothing'})."
        )

    # `-uall` is load-bearing for the size fence below, not a preference. Plain
    # `--porcelain` COLLAPSES a fully-untracked directory to a single `?? dir/`
    # entry, which is not a file, so the payload measured 0 and a 150 MB
    # artifact under a brand-new evidence dir sailed straight past the cap.
    # Caught by the fence's own test. `-uall` expands to individual files.
    status = _git("status", "--porcelain", "-uall", "--", str(pathspec), repo_root=repo_root)
    if status.returncode != 0:
        raise AutoCommitRefused(f"git status failed over {pathspec}: {status.stderr.strip()}")
    if not status.stdout.strip():
        return None

    # Fence 3: size. Measured on the working-tree files git reports as changed
    # or untracked, before anything is staged.
    payload = 0
    for line in status.stdout.splitlines():
        # Porcelain v1: two status chars, a space, then the path. Renames carry
        # `old -> new`; the post-rename path is the one with bytes on disk.
        raw = line[3:].split(" -> ")[-1].strip().strip('"')
        candidate = repo_root / raw
        if candidate.is_file():
            payload += candidate.stat().st_size
    if payload > _COMMIT_MAX_BYTES:
        raise AutoCommitRefused(
            f"refusing to auto-commit {payload} bytes under {pathspec} (cap "
            f"{_COMMIT_MAX_BYTES}). The evidence subtree is meant to hold packs and small "
            f"pinned artifacts; something large landed there. Commit it by hand after "
            f"deciding it belongs in history, or store it outside the repo."
        )

    # Fence 1: pathspec-limited, both halves. `git add` is needed because a new
    # date-stamped pack is UNTRACKED and a pathspec-limited commit alone would
    # not pick it up; `git commit -- <pathspec>` then takes the working-tree
    # content of exactly those paths and leaves any unrelated staged file of
    # Kos's alone, staged and uncommitted, rather than silently absorbing it.
    added = _git("add", "--", str(pathspec), repo_root=repo_root)
    if added.returncode != 0:
        raise AutoCommitRefused(f"git add failed over {pathspec}: {added.stderr.strip()}")

    committed = _git("commit", "-m", message, "--", str(pathspec), repo_root=repo_root)
    if committed.returncode != 0:
        raise AutoCommitRefused(
            f"git commit failed over {pathspec}: "
            f"{committed.stderr.strip() or committed.stdout.strip()}"
        )

    head = _git("rev-parse", "HEAD", repo_root=repo_root)
    return head.stdout.strip() if head.returncode == 0 else None


def collect_drift_events() -> list[dict[str, Any]]:
    """Recipe-lane repair events accumulated since anyone last looked.

    Surfaced even when the battery itself is green: a recipe that has been
    quietly failing validation between sweeps is exactly the case that must not
    stay quiet.
    """
    try:
        from r64_db_engine.drivers.rest.drift import all_events

        return all_events()
    except Exception as exc:  # noqa: BLE001
        print(f"[sweep] could not read recipe drift log: {exc}", file=sys.stderr)
        return []


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="factory-conformance-sweep",
        description="Run the conformance battery across every target; exit non-zero on any failure.",
    )
    parser.add_argument("--targets-dir", default=str(REPO_ROOT / "factory" / "targets"))
    parser.add_argument("--ground-truth-dir", default=str(REPO_ROOT / "bench"))
    parser.add_argument("--evidence-dir", default=str(REPO_ROOT / "factory" / "evidence"))
    parser.add_argument("--brief-dir", default=str(REPO_ROOT))
    parser.add_argument("--work-dir", default="/tmp/r64-factory-sweep")
    parser.add_argument("--target", default=None, help="sweep a single target by stem")
    parser.add_argument("--serve-gate", action="store_true")
    parser.add_argument(
        "--repair-store", action="store_true",
        help="pass --repair-store to each battery run (see factory.conformance)",
    )
    parser.add_argument("--date", default=None)
    parser.add_argument(
        "--auto-commit", action="store_true",
        help=(
            "commit the evidence subtree when the sweep is fully green (never on failure). "
            "OFF by default so a hand-run sweep does not create surprise commits; the "
            "systemd unit passes it, because the timer IS the evidence cadence."
        ),
    )
    parser.add_argument(
        "--per-target-timeout", type=int, default=1800,
        help=(
            "seconds before one target/table is killed (default 1800). A hung sweep is "
            "worse than a failed one: nothing alerts, and the timer looks healthy."
        ),
    )
    args = parser.parse_args(argv)

    evidence_dir = Path(args.evidence_dir)
    targets = discover_targets(Path(args.targets_dir), args.target)

    results: list[dict[str, Any]] = []
    for target in targets:
        results.extend(run_target(target, args))

    briefs: list[str] = []
    for result in results:
        if result["verdict"] == "PASS" and result["pack"]:
            snapshot_green(Path(result["pack"]), result["dialect"], evidence_dir)
        elif result["pack"] or result["verdict"] == "ERROR":
            brief = write_repair_brief(
                dialect=result["dialect"],
                target=result["target"],
                table=result["table"],
                pack_path=Path(result["pack"]) if result["pack"] else None,
                previous=last_green(result["dialect"], evidence_dir),
                brief_dir=Path(args.brief_dir),
                # Share the run's stamp, so one sweep's evidence pack and its
                # repair brief are named for the same date. Without this a
                # `--date`-pinned run filed the pack under the pinned stamp and
                # the brief under today's, which is exactly the pairing a
                # reader needs to be able to trust.
                date=args.date,
                error=result.get("error"),
            )
            briefs.append(str(brief))

    drift_events = collect_drift_events()

    print("\n" + "=" * 68)
    print("SWEEP SUMMARY")
    print("=" * 68)
    for result in results:
        print(f"  {result['verdict']:6s}  {result['target']:28s} {result['table']}")
    if drift_events:
        print(f"\n  {len(drift_events)} accumulated recipe drift event(s):")
        for event in drift_events[-10:]:
            print(f"    - {event.get('observed_utc')} {event.get('source')}/"
                  f"{event.get('recipe')}: {event.get('reason')}")
    for brief in briefs:
        print(f"\n  REPAIR BRIEF WRITTEN: {brief}")

    failed = [r for r in results if r["verdict"] != "PASS"]

    # Auto-commit runs BEFORE the verdict is printed and can itself turn the
    # sweep red. A pack that was generated but never became a committed file
    # has not, by this project's own doctrine, been produced at all.
    commit_refused: str | None = None
    if args.auto_commit:
        allowed, reason = should_auto_commit(results, drift_events)
        if not allowed:
            print(f"\n[sweep] auto-commit SKIPPED — {reason}")
        else:
            stamp = args.date or datetime.now().strftime("%Y%m%d")
            try:
                sha = auto_commit_green(
                    evidence_dir, commit_message(stamp, results, args.target)
                )
            except AutoCommitRefused as exc:
                commit_refused = str(exc)
                print(f"\n[sweep] auto-commit REFUSED — {exc}", file=sys.stderr)
            else:
                if sha is None:
                    print("\n[sweep] auto-commit: evidence unchanged, nothing to commit")
                else:
                    print(f"\n[sweep] auto-commit: {sha[:12]} evidence: sweep {stamp}, "
                          f"{len(results)}/{len(results)} PASS")

    # Accumulated drift events fail the sweep even when every battery is green.
    # They are evidence that a provider already changed; a green verdict beside
    # an unread repair log is the shape of a problem going unnoticed.
    if drift_events:
        print(f"\n[sweep] FAIL — {len(drift_events)} unresolved recipe drift event(s)")
    if failed:
        print(f"\n[sweep] FAIL — {len(failed)} of {len(results)} target/table runs failed")
    if commit_refused:
        print("\n[sweep] FAIL — every battery was green but the evidence could not be "
              "committed, so this sweep produced no durable record")
    if failed or drift_events or commit_refused:
        return 1
    print(f"\n[sweep] PASS — {len(results)} target/table run(s) green")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
